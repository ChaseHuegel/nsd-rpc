<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Benchmark-only dependency. This project does not ship. -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <!-- The schema is the source of truth for the benchmark payloads. -->
    <PackageReference Include="Needlefish.Generators" Version="1.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NsdRpc/NsdRpc.csproj" />
    <ProjectReference Include="../NsdRpc.Tcp/NsdRpc.Tcp.csproj" />
  </ItemGroup>

</Project>
