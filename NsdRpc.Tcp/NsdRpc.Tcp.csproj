<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NsdRpc.Tcp</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NsdRpc.Tcp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Chase Huegel</Authors>
    <Description>A TCP transport for the nsd-rpc framework.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ChaseHuegel/nsd-rpc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ChaseHuegel/nsd-rpc.git</RepositoryUrl>
    <PackageTags>rpc;nsd;needlefish;tcp;networking</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NsdRpc/NsdRpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NsdRpc.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
