<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NsdRpc.Generators</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The RpcServiceAttribute source compiles to nothing here; the generator emits it. -->
    <DefineConstants>$(DefineConstants);NSDRPC_GENERATORS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NsdRpc.Generators</PackageId>
    <Version>0.1.0</Version>
    <Authors>Chase Huegel</Authors>
    <Description>Source generator for NsdRpc: emits typed service clients from [RpcService] interfaces.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ChaseHuegel/nsd-rpc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ChaseHuegel/nsd-rpc.git</RepositoryUrl>
    <PackageTags>rpc;nsd;source-generator;networking</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="RpcServiceAttribute.cs" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
